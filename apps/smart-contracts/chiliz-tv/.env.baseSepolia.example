# ==============================================================================
# ChilizTV Smart Contracts - Base Sepolia (chain 84532)
# ==============================================================================
# Copy to `.env.baseSepolia` (deploy.sh picks it for --network baseSepolia):
#   cp .env.baseSepolia.example .env.baseSepolia
#   ./deploy.sh --network baseSepolia --all --dry-run
#
# The contracts are unchanged on Base: Uniswap V2 Router02 has the same ABI
# as the Kayen routers, WETH plays the role of WCHZ and native ETH the role
# of CHZ (the `*WithCHZ` entrypoints take ETH). There are no fan tokens on
# Base. Addresses below were checked on-chain on 2026-11-05 (audit §7).
# See .env.example for the meaning of every variable. Never put a real
# secret in this file: it is committed.

# ── Network ──────────────────────────────────────────────────────────────────
RPC_URL=https://sepolia.base.org
CHAIN_ID=84532
EXPLORER_URL=https://sepolia.basescan.org
# EIP-1559 works on Base: no --legacy / --with-gas-price / --skip-simulation.
FORGE_FLAGS=

# ── Keys and owners ──────────────────────────────────────────────────────────
# Fresh deployer key for this chain (do NOT reuse a key that ever leaked).
PRIVATE_KEY=
# Safe deployed ON BASE SEPOLIA (a Safe address from another chain has no code here).
SAFE_ADDRESS=
ADMIN_ADDRESS=
# Owner of the match beacons (only key able to change match code). Default SAFE_ADDRESS.
UPGRADE_ADMIN=
# Backend hot key allowed to create matches once the Safe owns the factory
# (DeployAll; default: the deployer). Must differ from ORACLE_ADDRESS.
MATCH_OPERATOR=

# Optional TimelockController delay in seconds in front of the beacons (0 = none).
TIMELOCK_DELAY=0
# Test chain: false keeps the deployer as owner. Use true to hand over to the Safe.
TRANSFER_OWNERSHIP=false

# ── Tokens and DEX ───────────────────────────────────────────────────────────
# Circle USDC (6 decimals)
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
# WETH (stands in for WCHZ)
WCHZ_ADDRESS=0x4200000000000000000000000000000000000006
# Uniswap V2 Router02 for both slots (exposes 0x7ff36ab5 and 0x38ed1739; WETH() = 0x4200…0006).
# Do NOT use 0x94cC0AaC535CCDB3C01d6787D6413C739ae12bc4 (Uniswap V3 SwapRouter02, different ABI).
# The WETH/USDC V2 pair (0x0B9Ab53880be6fF805ebF8FBce515E5715ccE1bE) holds ~150 USDC: test amounts only.
KAYEN_MASTER_ROUTER=0x1689E7B1F10000AE47eBfE339a4f69dECd19F602
KAYEN_ROUTER=0x1689E7B1F10000AE47eBfE339a4f69dECd19F602
# No Kayen fan-token wrapper on Base.
WRAPPER_FACTORY=

# ── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_FEE_BPS=500

# ── DeployPari only ──────────────────────────────────────────────────────────
# The oracle must differ from OWNER_ADDRESS and from the deployer (audit H-01).
OWNER_ADDRESS=
ORACLE_ADDRESS=
FEE_RECIPIENT=
SKIP_SAMPLE_MATCH=false
SAMPLE_MATCH_NAME="Base FC vs Sepolia United"

# ── Existing deployments (upgrade / rewiring scripts) ────────────────────────
PARI_FACTORY_ADDRESS=
STREAM_FACTORY_ADDRESS=
LEADERBOARD_PROXY=
FACTORY_ADDRESS=
STREAMER_WALLETS=

# ── Verification and tests ───────────────────────────────────────────────────
# Etherscan API v2 key (foundry.toml [etherscan].base_sepolia) for --verify.
ETHERSCAN_API_KEY=
# RPC for test/fork/BaseSepoliaFork.t.sol (default https://sepolia.base.org).
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
