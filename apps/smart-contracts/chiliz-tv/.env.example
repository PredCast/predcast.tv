# ==============================================================================
# ChilizTV Smart Contracts - Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control!
#
# deploy.sh loads `.env.<network>` when it exists (e.g. .env.chilizMainnet),
# otherwise `.env`. Keeping one file per network avoids mixing addresses.
#
# Usage with deploy.sh:
#   cp .env.example .env
#   # Fill in values below
#   ./deploy.sh --network chilizTestnet --all
#
# Usage with forge directly:
#   source .env
#   forge script script/DeployAll.s.sol --rpc-url $RPC_URL --private-key $PRIVATE_KEY --broadcast $FORGE_FLAGS -vvvv
#
# Every variable below is read by deploy.sh, a script in script/, foundry.toml
# or the fork tests. For Base Sepolia start from .env.baseSepolia.example. Values shown are Chiliz Spicy testnet defaults; mainnet
# values are in comments. forge also auto-loads .env from this directory.

# ==============================================================================
# REQUIRED — Network (deploy.sh)
# ==============================================================================

# RPC endpoint
#   Chiliz Spicy Testnet: https://spicy-rpc.chiliz.com
#   Chiliz Mainnet:       https://rpc.chiliz.com
RPC_URL=https://spicy-rpc.chiliz.com

# EVM chain id — must match --network (deploy.sh aborts on mismatch)
#   Chiliz Spicy Testnet: 88882
#   Chiliz Mainnet:       88888
CHAIN_ID=88882

# Block explorer (informational — printed after deploy)
#   Spicy:   https://testnet.chiliscan.com
#   Mainnet: https://chiliscan.com
EXPLORER_URL=https://testnet.chiliscan.com

# Extra flags passed to `forge script`
#   Chiliz needs --legacy (no EIP-1559) and a gas price ABOVE eth_gasPrice
#   (~2,501 gwei on both networks as of 2026-11; check with
#   `cast gas-price --rpc-url $RPC_URL`). deploy.sh refuses to broadcast below
#   the live floor: an underpriced tx sits in the mempool and locks the nonce.
#   --skip-simulation avoids Chiliz-specific simulation failures.
#   --gas-limit is required because eth_estimateGas on Chiliz returns
#     "contract creation code storage out of gas" for larger contracts;
#     30M ≈ Chiliz block gas limit and covers any single deploy.
FORGE_FLAGS="--legacy --with-gas-price 3500000000000 --skip-simulation --gas-limit 30000000"

# ==============================================================================
# REQUIRED — Deployment keys and owners
# ==============================================================================

# Deployer private key (hot wallet — NOT your multisig key). Required by deploy.sh.
# ⚠️  Use a dedicated deployment wallet. See SECURITY section below.
PRIVATE_KEY=

# Gnosis Safe multisig (treasury / fee sink; final owner when TRANSFER_OWNERSHIP=true).
# Required by deploy.sh, DeployAll, DeployStreaming, DeploySwap, RedeploySwapRouter.
# Must be a contract on the target chain: a Safe address from another chain
# has no code here and ownership sent to it is lost.
SAFE_ADDRESS=

# Informational only: deploy.sh prints it in the gas-price warning.
ADMIN_ADDRESS=

# Start the transfer of the factories + router ownership to SAFE_ADDRESS (or
# FEE_RECIPIENT for DeployPari) at the end of the run. Ownable2Step: the Safe
# must then call acceptOwnership() on each contract. Default: false on test
# chains (Spicy 88882, Base Sepolia 84532, anvil), TRUE everywhere else.
# Outside test chains the Safe must have code on the target chain.
TRANSFER_OWNERSHIP=false

# Owner of the match beacons = the only key able to change match code
# Default: SAFE_ADDRESS (FEE_RECIPIENT for DeployPari).
UPGRADE_ADMIN=

# Backend hot key allowed to create matches once the Safe owns the factory
# (DeployAll; default: the deployer). Must differ from ORACLE_ADDRESS.
MATCH_OPERATOR=

# Seconds. > 0 puts a TimelockController (proposer/executor = UPGRADE_ADMIN)
# in front of the beacons. 0 = no timelock (current team decision).
TIMELOCK_DELAY=0

# ==============================================================================
# REQUIRED — Token & DEX Addresses
# ==============================================================================

# USDC token address (6 decimals).
#   Spicy:   0x66f3ee96a0185216f8cb427d2bc4e53947cef60c
#   Mainnet: 0xa37936F56249965d407E39347528a1A91eB1cbef
USDC_ADDRESS=0x66f3ee96a0185216f8cb427d2bc4e53947cef60c

# Kayen DEX routers.
#
# KAYEN_MASTER_ROUTER: router used by NetworkRouter for native CHZ swaps
#   (standard V2 `swapExactETHForTokens(uint256,address[],address,uint256)`).
#   ⚠ Point it at the vanilla V2 router, i.e. the SAME address as KAYEN_ROUTER.
#   Kayen's real MasterRouter (mainnet 0xfAf3…2E9d) reverts on every swap that
#   ends in USDC — see src/interfaces/IKayenMasterRouterV2.sol (audit C-01).
#
# KAYEN_ROUTER: Uniswap V2 fork used for ERC20 → USDC swaps
#   (`swapExactTokensForTokens`), also read by DeployStreaming.
#
#   Spicy:   both 0xb82b0e988a1FcA39602c5079382D360C870b44c8
#   Mainnet: both 0x1918EbB39492C8b98865c5E53219c3f1AE79e76F
#   (live NetworkRouter on each network, checked 2026-11-05)
#
# deploy.sh warns when the two are equal; that is the expected setup.
# Docs: https://kayen-protocol.gitbook.io/documentation/references/contracts
KAYEN_MASTER_ROUTER=0xb82b0e988a1FcA39602c5079382D360C870b44c8
KAYEN_ROUTER=0xb82b0e988a1FcA39602c5079382D360C870b44c8

# Wrapped CHZ (WCHZ) token address
#   Spicy:   0x678c34581db0a7808d0aC669d7025f1408C9a3C6
#   Mainnet: 0x677F7e16C7Dd57be1D4C8aD1244883214953DC47
WCHZ_ADDRESS=0x678c34581db0a7808d0aC669d7025f1408C9a3C6

# Kayen wrapper factory for CAP-20 fan tokens (0-decimal) → wrapped ERC20.
# Optional: leave empty to disable fan-token wrapping in NetworkRouter.
# Read by DeployAll, DeploySwap, RedeploySwapRouter.
#   Mainnet: 0xAEdcF2bf41891777c5F638A098bbdE1eDBa7B264
WRAPPER_FACTORY=

# ==============================================================================
# OPTIONAL — Platform Configuration
# ==============================================================================

# Platform fee in basis points (default: 500 = 5%)
# Used by NetworkRouter and StreamWalletFactory. Required by DeployPari.
# Examples: 100 = 1%, 200 = 2%, 500 = 5%, 1000 = 10%
PLATFORM_FEE_BPS=500

# ==============================================================================
# DeployPari.s.sol only (./deploy.sh --pari)
# ==============================================================================

# PariMatchFactory owner, oracle (RESOLVER_ROLE) and fee recipient.
# The oracle MUST be a dedicated key: the factory rejects an oracle equal to
# the match owner or to the factory owner.
OWNER_ADDRESS=
ORACLE_ADDRESS=
FEE_RECIPIENT=

# Sample match created at the end of DeployPari (skip with SKIP_SAMPLE_MATCH=true).
SKIP_SAMPLE_MATCH=false
SAMPLE_MATCH_NAME="Barcelona vs Real Madrid"

# ==============================================================================
# EXISTING DEPLOYMENTS (upgrade / rewiring scripts)
# ==============================================================================
# Live addresses are in deployments/<network>.json.

# RedeploySwapRouter (./deploy.sh --redeploy-swap) and
# RotateSwapRouterRoleOnMatches: the factories to rewire.
#   Mainnet: PariMatchFactory    0x1e7f73d14d3e87205a766a14ec5847c12febffd7
#            StreamWalletFactory 0x0ffa30b48adc0b2b773dc01422d249aee135a4bb
PARI_FACTORY_ADDRESS=
STREAM_FACTORY_ADDRESS=

# RotateSwapRouterRoleOnMatches: router receiving SWAP_ROUTER_ROLE, router losing
# it (optional), and an optional comma-separated match list (default: every
# match of PARI_FACTORY_ADDRESS).
NEW_ROUTER=
OLD_ROUTER=
MATCHES=

# UpgradeLeaderboard (./deploy.sh --upgrade-leaderboard): the ERC1967 PROXY,
# not the implementation.
#   Mainnet: 0x3210326343f4c682ff3d9d29727bb61785def55b
LEADERBOARD_PROXY=

# UpgradeStreaming: StreamWalletFactory to point at a new StreamWallet
# implementation, and comma-separated STREAMER addresses (not wallet
# addresses) whose wallets get upgraded via factory.upgradeWallet.
#   Mainnet: FACTORY_ADDRESS=0x0ffa30b48adc0b2b773dc01422d249aee135a4bb
FACTORY_ADDRESS=
STREAMER_WALLETS=

# ==============================================================================
# OPTIONAL — Verification and tests
# ==============================================================================

# Block explorer API key, used by foundry.toml [etherscan] (routescan) for --verify.
ETHERSCAN_API_KEY=

# RPC used by the Chiliz mainnet fork tests (default https://rpc.chiliz.com).
# Leave commented out unless you need another endpoint: set but empty, it
# overrides the default with "" and the fork tests fail.
# CHILIZ_RPC_URL=https://rpc.chiliz.com
# Same for test/fork/BaseSepoliaFork.t.sol (default https://sepolia.base.org).
# BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# ==============================================================================
# SECURITY BEST PRACTICES
# ==============================================================================
#
# DEPLOYMENT KEY vs MULTISIG:
# ✅ DO:
#    - Use a dedicated HOT wallet for PRIVATE_KEY (deployment only)
#    - Fund it with just enough CHZ for gas
#    - Set TRANSFER_OWNERSHIP=true outside testnet so ownership moves to SAFE_ADDRESS
#    - Delete/rotate the deployment key after successful deployment
#    - Use a separate oracle key (ORACLE_ADDRESS) from the owner key
#
# ❌ DON'T:
#    - Never deploy directly from a multisig (won't work)
#    - Never use your main wallet's private key
#    - Never leave the deployer as owner on mainnet
#    - Never commit .env (or .env.<network>) to git, and never put a real
#      value in this example file: it is public
#
# RECOMMENDED FLOW:
#    1. Generate fresh deployment keypair
#    2. Fund it for gas
#    3. Run: ./deploy.sh --network chilizTestnet --all --dry-run, then without --dry-run
#    4. Verify contracts on explorer
#    5. Confirm ownership is SAFE_ADDRESS
#    6. Rotate/delete deployment key
#
# POST-DEPLOYMENT: DeployAll deploys and wires the whole platform
# (PariMatchFactory, StreamWalletFactory, NetworkRouter, LeaderboardRewards).
# For a router redeploy use ./deploy.sh --redeploy-swap, then
# RotateSwapRouterRoleOnMatches for the existing matches. StreamWallets on the
# post-M-04 implementation follow the factory's router automatically; older
# ones must first be upgraded with script/UpgradeStreaming.s.sol.
