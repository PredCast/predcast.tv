# ==============================================================================
# ChilizTV Smart Contracts - Base mainnet (chain 8453)
# ==============================================================================
# Copy to `.env.baseMainnet` (deploy.sh picks it for --network baseMainnet):
#   cp .env.baseMainnet.example .env.baseMainnet
#   ./deploy.sh --network baseMainnet --all --dry-run
#
# WETH plays the role of WCHZ and native ETH the role of CHZ (the `*WithCHZ`
# entrypoints take ETH). Fan tokens with liquidity: CHZ, PSG, AFC, PEPPER. Addresses
# below were checked on-chain on 2026-11-08. Pool addresses live in
# script/config/BaseDexConfig.sol, selected by chain id.
# See .env.example for the meaning of every variable. Never put a real
# secret in this file: it is committed.

# ── Network ──────────────────────────────────────────────────────────────────
RPC_URL=https://mainnet.base.org
CHAIN_ID=8453
EXPLORER_URL=https://basescan.org
# EIP-1559 works on Base: no --legacy / --with-gas-price / --skip-simulation.
FORGE_FLAGS=

# ── Keys and owners ──────────────────────────────────────────────────────────
# Fresh deployer key for this chain (do NOT reuse a key that ever leaked).
PRIVATE_KEY=
# Safe deployed ON BASE (a Safe address from another chain has no code here).
SAFE_ADDRESS=
ADMIN_ADDRESS=
# Owner of the match beacons (only key able to change match code). Default SAFE_ADDRESS.
UPGRADE_ADMIN=
# Backend hot key allowed to create matches once the Safe owns the factory
# (DeployAll; default: the deployer). Must differ from ORACLE_ADDRESS.
MATCH_OPERATOR=

# Optional TimelockController delay in seconds in front of the beacons (0 = none).
TIMELOCK_DELAY=0
# Mainnet: true hands the contracts over to the Safe (it must call acceptOwnership on each).
TRANSFER_OWNERSHIP=true

# ── Tokens and DEX ───────────────────────────────────────────────────────────
# Circle USDC (6 decimals)
USDC_ADDRESS=0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# WETH (stands in for WCHZ)
WCHZ_ADDRESS=0x4200000000000000000000000000000000000006
# Leave both empty for --all: it deploys a ConcentratedPoolAdapter that swaps on
# Aerodrome Slipstream pools (WETH, CHZ, PSG, AFC and PEPPER to USDC).
# After that run, put the adapter address here for --pari, --swap and --redeploy-swap.
KAYEN_MASTER_ROUTER=
KAYEN_ROUTER=
# No Kayen fan-token wrapper on Base.
WRAPPER_FACTORY=

# ── Platform ─────────────────────────────────────────────────────────────────
PLATFORM_FEE_BPS=500

# ── DeployPari only ──────────────────────────────────────────────────────────
# The oracle must differ from OWNER_ADDRESS and from the deployer (audit H-01).
OWNER_ADDRESS=
ORACLE_ADDRESS=
FEE_RECIPIENT=
SKIP_SAMPLE_MATCH=false
SAMPLE_MATCH_NAME="Base FC vs Mainnet United"

# ── Existing deployments (upgrade / rewiring scripts) ────────────────────────
PARI_FACTORY_ADDRESS=
STREAM_FACTORY_ADDRESS=
LEADERBOARD_PROXY=
FACTORY_ADDRESS=
STREAMER_WALLETS=

# ── Verification and tests ───────────────────────────────────────────────────
# Etherscan API v2 key (foundry.toml [etherscan].base) for --verify.
ETHERSCAN_API_KEY=
# RPC for test/fork/BaseDexAdapterFork.t.sol (default https://mainnet.base.org).
# BASE_RPC_URL=https://mainnet.base.org
